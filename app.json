      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8ac53511-29fd-4252-baea-b44623af8acb"
      }
    },
    "owner": "louisadriano",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8ac53511-29fd-4252-baea-b44623af8acb"
    }
  }
}
